_build/
target/
.mooncakes/
.moonagent/
*.gguf
__pycache__/
*.pyc
test_model.gguf

# Local tool state (security scanner ledger), not part of the project
.mimosa/

# MoonBit profiler output, written by `moon run --trace`
trace.json

# `moon info` writes these into the source tree; they are tool output, not
# source. `moon publish` honours `.gitignore` (measured: an ignored untracked
# file is not packed, an unignored one is), so this rule keeps them out of
# releases as well as out of git.
*.generated.mbti

# The browser preview bundle. `tools/serve_web.py` assembles it from
# `web/index.html` plus the js build; docs/browser.md calls it "a preview
# build, not a published artifact". Tracking it forced every release to move
# the directory out by hand; the `web/dist/` rule below removes that step.
web/dist/
